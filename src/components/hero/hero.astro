---
import { hero, lenses } from '../../data/site.config';
import LensGallery from '../lens/lens-gallery';
import GithubLink from '../github-link/github-link.astro';
import { fetchStars } from '../../lib/github-stars/github-stars';
const stars = await fetchStars();
const words = hero.headline.split(' ');
const rest = hero.lede.slice(hero.ledeLead.length);
const cut = rest.indexOf(hero.ledeBadge.after) + hero.ledeBadge.after.length;
const [beforeBadge, afterBadge] = [rest.slice(0, cut - hero.ledeBadge.after.length), rest.slice(cut)];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="rules" aria-hidden="true"></div>
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="wrap hero__head">
    <p class="eyebrow mono" data-reveal style="--d:0s">
      <span class="live" aria-hidden="true"></span>{hero.eyebrow}
    </p>

    <h1 id="hero-title" class="hero__title" aria-label={hero.headline}>
      {words.map((w, i) => (
        <><span class="w" aria-hidden="true"><span class="w__in" style={`--i:${i}`}>{w}</span></span>{" "}</>
      ))}
    </h1>

    <p class="hero__lede" data-reveal style="--d:0.08s"><strong>{hero.ledeLead}</strong>{beforeBadge}<span class="hero__tie">{hero.ledeBadge.after}<img class="hero__badge" src={hero.ledeBadge.src} width="96" height="96" alt="" /></span>{afterBadge}</p>

    <div class="hero__cta" data-reveal style="--d:0.16s">
      <a class="btn btn--solid" href={hero.primary.href}>
        <span class="btn__label"><span data-text={hero.primary.label}>{hero.primary.label}</span></span>
        <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
      <GithubLink href={hero.secondary.href} label={hero.secondary.label} stars={stars} />
    </div>
  </div>

  <div class="wrap hero__foot">
    <p class="hero__stat" data-count={hero.stat.value}>
      <span class="hero__stat-label mono muted">{hero.stat.label}</span>
      <span class="hero__stat-value" data-count-text>$4,045.19</span>
    </p>
    <p class="hero__note mono muted" data-reveal style="--d:0.24s">{lenses.note}</p>
  </div>

  <div class="hero__stage">
    <LensGallery lenses={lenses.items} client:visible />
  </div>
</section>
