---
import { selfHost } from '../../data/site.config';
import CopyButton from '../copy-button/copy-button.astro';
---
<section class="host" id={selfHost.id} aria-labelledby="host-title">
  <div class="wrap host__grid">
    <div class="host__lead">
      <div class="host__lead-in">
        <h2 id="host-title" class="h-xl" data-reveal>{selfHost.heading}</h2>
        <p class="host__body" data-reveal>{selfHost.body}</p>
      </div>
    </div>

    <div class="host__main">
      <div class="term" data-reveal>
        <div class="term__bar mono muted"><span>Terminal</span><CopyButton text={selfHost.command} label="Copy docker compose command" /></div>
        <pre class="term__code"><code><span class="muted" aria-hidden="true">$ </span>{selfHost.command}</code></pre>
      </div>
      <div class="term term--alt" data-reveal>
        <div class="term__bar mono muted"><span>With a password</span><CopyButton text={selfHost.passwordCommand} label="Copy docker compose command with a password" /></div>
        <pre class="term__code"><code><span class="muted" aria-hidden="true">$ </span>{selfHost.passwordCommand}</code></pre>
      </div>
      <p class="muted host__note" data-reveal>{selfHost.passwordNote}</p>

      <h3 class="h-m host__sub" data-reveal>{selfHost.configHeading}</h3>
      <table class="cfg" data-reveal>
        <thead class="sr-only"><tr><th>Variable</th><th>Default</th><th>Purpose</th></tr></thead>
        <tbody>
          {selfHost.config.map((r) => (
            <tr><th scope="row"><code>{r.name}</code></th><td class="muted">{r.fallback}</td><td>{r.purpose}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <ul class="sec">
      {selfHost.security.map((s, i) => (
        <li data-reveal style={`--d:${i * 0.08}s`}>
          <h3 class="h-m">{s.title}</h3>
          <p class="muted">{s.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
