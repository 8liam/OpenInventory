---
import { Image } from 'astro:assets';
import { story } from '../../data/site.config';
const total = String(story.chapters.length).padStart(2, '0');
---
<section class="story" id={story.id} aria-labelledby="story-title" data-story>
  <div class="wrap story__head">
    <h2 id="story-title" class="h-xl" data-reveal>{story.heading}</h2>
  </div>

  <div class="wrap story__grid">
    <ol class="story__chapters">
      {story.chapters.map((c, i) => (
        <li class="chapter" data-chapter={i} id={c.id}>
          <div class="chapter__copy" data-reveal>
            <p class="mono muted chapter__idx">{String(i + 1).padStart(2, '0')} / {total} <span aria-hidden="true">·</span> {c.view}</p>
            <h3 class="h-l">{c.title}</h3>
            <p class="chapter__body">{c.body}</p>
            <ul class="ticks">
              {c.points.map((p) => <li>{p}</li>)}
            </ul>
          </div>
          <p class={`chapter__fig${c.figure.value < 0 ? ' is-neg' : ''}`} aria-hidden="true">{`${c.figure.value < 0 ? '-' : ''}${c.figure.prefix}${Math.abs(c.figure.value).toLocaleString('en-US', { minimumFractionDigits: c.figure.decimals, maximumFractionDigits: c.figure.decimals })}${c.figure.suffix}`}<span class="mono muted">{c.figure.label}</span></p>
          <div class="shot shot--inline">
            <Image src={c.crop} alt={c.alt} widths={[420, 640, 840]} sizes="(min-width: 700px) 640px, 94vw" format="webp" quality={85} loading="lazy" decoding="async" />
          </div>
        </li>
      ))}
    </ol>

    <div class="story__stage" aria-hidden="true">
      <div class="story__sticky">
        <div class="shot shot--stage">
          {story.chapters.map((c, i) => (
            <div class="layer" data-layer={i} data-on={i === 0 ? '' : undefined}>
              <div class="layer__img"><Image src={c.image} alt="" widths={[960, 1280, 1600]} sizes="(min-width: 1500px) 880px, 56vw" format="webp" quality={82} loading="lazy" decoding="async" /></div>
              <div class="lens"><Image src={c.crop} alt="" widths={[480, 720]} sizes="460px" format="webp" quality={86} loading="lazy" decoding="async" /></div>
            </div>
          ))}
        </div>
        <div class="stage__cap" data-stage-cap>
          <p class="stage__fig" data-fig>{story.chapters[0].figure.prefix}{story.chapters[0].figure.value.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</p>
          <p class="mono muted"><span data-fig-label>{story.chapters[0].figure.label}</span> <span aria-hidden="true">·</span> <span data-stage-route>{story.chapters[0].route}</span></p>
        </div>
      </div>
    </div>
  </div>
</section>
