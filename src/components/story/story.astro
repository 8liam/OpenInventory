---
import { story } from '../../data/site.config';
import DashboardDemo from '../../mock/demo/dashboard-demo';
import ItemsDemo from '../../mock/demo/items-demo';
import StorageDemo from '../../mock/demo/storage-demo';
import CasesDemo from '../../mock/demo/cases-demo';
import TradeUpDemo from '../../mock/demo/tradeup-demo';

const total = String(story.chapters.length).padStart(2, '0');
const fmtFig = (f: (typeof story.chapters)[number]['figure']) =>
  `${f.value < 0 ? '-' : ''}${f.prefix}${Math.abs(f.value).toLocaleString('en-US', { minimumFractionDigits: f.decimals, maximumFractionDigits: f.decimals })}${f.suffix}`;
---
<section class="story" id={story.id} aria-labelledby="story-title" data-story>
  <div class="wrap story__head">
    <h2 id="story-title" class="h-xl" data-reveal>{story.heading}</h2>
    <p class="story__note" data-reveal>{story.note}</p>
  </div>

  <div class="wrap">
    <ol class="story__rows">
      {story.chapters.map((c, i) => (
        <li class:list={['row', { 'row--flip': i % 2 === 1 }]} id={c.id} data-row={i}>
          <div class="row__copy" data-reveal>
            <p class="mono muted row__idx">{String(i + 1).padStart(2, '0')} / {total} <span aria-hidden="true">·</span> {c.view}</p>
            <h3 class="h-l">{c.title}</h3>
            <p class="row__body">{c.body}</p>
            <ul class="ticks">
              {c.points.map((p) => <li>{p}</li>)}
            </ul>
            <p class:list={['row__fig', { 'is-neg': c.figure.value < 0 }]} aria-hidden="true"
               data-fig data-value={c.figure.value} data-prefix={c.figure.prefix} data-suffix={c.figure.suffix} data-decimals={c.figure.decimals}>
              {fmtFig(c.figure)}<span class="mono">{c.figure.label}</span>
            </p>
          </div>
          <div class="win">
            <div class="win__bar mono"><span>{c.route}</span><span class="win__hint">{c.hint}</span></div>
            <div class="win__body">
              {c.id === 'dashboard' && <DashboardDemo client:visible />}
              {c.id === 'items' && <ItemsDemo client:visible />}
              {c.id === 'storage' && <StorageDemo client:visible />}
              {c.id === 'cases' && <CasesDemo client:visible />}
              {c.id === 'tradeup' && <TradeUpDemo client:visible />}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
