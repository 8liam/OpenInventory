---
import { story } from '../../data/site.config';
import FeatureDemo from './feature-demo';
import FeatureCards from './feature-cards';
---
<section class="features" id={story.id} aria-labelledby="features-title">
  <div class="wrap">
    <header class="features__head">
      <h2 id="features-title" class="h-l" data-reveal>{story.heading}</h2>
      <p class="features__note muted" data-reveal>{story.note}</p>
    </header>

    <ol class="features__list">
      {story.chapters.map((c, i) => (
        <li class="fchap" data-reveal>
          <p class="fchap__idx mono muted">
            {String(i + 1).padStart(2, '0')} <span aria-hidden="true">·</span> {c.view}
          </p>
          <div class="fchap__frame">
            <p class="fchap__hint mono muted">{c.hint}</p>
            <div class="fchap__stage">
              <FeatureDemo id={c.id} client:visible />
            </div>
          </div>
          <FeatureCards title={c.title} body={c.body} points={c.points} client:visible />
        </li>
      ))}
    </ol>
  </div>
</section>
