---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import dashboard from '../assets/dashboard.png';
---
<Base title="OG card" noindex>
  <section class="og">
    <p class="og__t">Your inventory. Open.</p>
    <p class="og__s">Self-hosted CS2 inventory and storage unit tracker</p>
    <div class="og__img"><Image src={dashboard} alt="" width={1100} format="webp" loading="eager" /></div>
  </section>
</Base>
<style is:global>
  .og { position: relative; width: 1200px; height: 630px; overflow: hidden; padding: 56px 64px; background: radial-gradient(60% 80% at 80% 90%, rgb(222 155 53 / 0.22), transparent), var(--c-bg); }
  .og__t { font-size: 72px; line-height: 0.95; letter-spacing: -0.055em; font-weight: 600; max-width: 700px; }
  .og__s { margin-top: 22px; font-family: var(--f-mono); font-size: 18px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--c-accent); }
  .og__img { position: absolute; left: 330px; top: 360px; width: 1000px; border: 1px solid var(--c-line); border-radius: 14px; overflow: hidden; box-shadow: 0 30px 80px rgb(0 0 0 / 0.7); }
  .og__img img { width: 100%; }
  .skip-link, .hdr { display: none; }
</style>
