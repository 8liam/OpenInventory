---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/site-header/site-header.astro';
import SiteFooter from '../components/site-footer/site-footer.astro';
---
<Base title="Not found | OpenInventory" description="This page is not in the inventory." noindex>
  <SiteHeader slot="header" />
  <section class="nf wrap">
    <p class="mono muted">Error 404</p>
    <h1 class="nf__t">Item not found.</h1>
    <p class="nf__b muted">Nothing is stored at this address. It may have moved to another unit.</p>
    <a class="btn btn--solid" href="/">
      <span class="btn__label"><span data-text="Back to the dashboard">Back to the dashboard</span></span>
      <span class="btn__arrow" aria-hidden="true">→</span>
    </a>
  </section>
  <SiteFooter slot="footer" />
</Base>
