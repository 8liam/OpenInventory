{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "weapon": {
      "type": "string",
      "minLength": 1
    },
    "finish": {
      "type": "string",
      "minLength": 1
    },
    "retrieved": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "phases": {
      "type": "object",
      "properties": {
        "tierCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "paintIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "tier": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "paintIndex",
              "label",
              "tier"
            ]
          }
        }
      },
      "required": [
        "tierCount",
        "entries"
      ]
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "paintIndexes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "tiers": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "seeds": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000
                  }
                }
              },
              "required": [
                "seeds"
              ]
            }
          }
        },
        "required": [
          "label",
          "tiers"
        ]
      }
    }
  },
  "required": [
    "weapon",
    "finish",
    "retrieved",
    "sources"
  ]
}
