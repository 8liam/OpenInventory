{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "plugins/**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "~/lib/storage/storage.client": [
        "./src/mock/data/storage-client.mock.ts"
      ],
      "~/*": [
        "../src/*"
      ],
      "@demo/*": [
        "./src/mock/*"
      ],
      "*": [
        "./node_modules/@types/*",
        "./node_modules/*"
      ],
      "@tanstack/react-router": [
        "./src/mock/stubs/react-router.tsx"
      ]
    },
    "types": [
      "node"
    ]
  }
}
