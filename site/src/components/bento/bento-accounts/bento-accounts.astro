---
import { formatMoney } from '~/utils/format';
import { bento } from '../bento.config';
import { sampleItem } from '../bento.data';
import BentoThumb from '../bento-thumb/bento-thumb.astro';
import BentoIcon from '../bento-icon/bento-icon.astro';

const { accounts } = bento;
const total = accounts.list.reduce((sum, account) => sum + account.value, 0);
const waiting = accounts.list.filter((account) => account.status === 'error');
const connectedTotal = accounts.list.filter((account) => account.status === 'ready').reduce((sum, account) => sum + account.value, 0);
const selected = accounts.list[accounts.selectedAccount];
const rows = accounts.rows.map((row) => ({ ...sampleItem(row.itemName), account: accounts.list[row.account] }));
const money = (value: number) => formatMoney(value, accounts.currencyCode);
---
<div class="bacc bento__stage bento__ui" style={`--account-cycle:${accounts.cycleSeconds}s`}>
  <header class="bacc__header">
    <div><span class="bacc__muted">{accounts.savedLabel}</span><p class="bacc__total">{money(total)}</p></div>
    <span class="bacc__sample">{accounts.sampleTag}</span>
  </header>
  <p class="bacc__muted bacc__saved-hint">{accounts.savedHint}</p>
  <div class="bacc__workspace">
    <div class="bento__panel bacc__switcher">
      <div class="bacc__switch-head">
        <span class="bacc__swap"><span class="bacc__all">{accounts.allLabel}</span><span class="bacc__single">{selected.name}</span></span>
        <svg class="bacc__arrows" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16m-4-4 4 4-4 4M20 17H4m4-4-4 4 4 4" /></svg>
      </div>
      <p class="bacc__summary">{accounts.summary(accounts.list.length, waiting.length)}</p>
      <div class="bacc__option bacc__option--all"><span>{accounts.allLabel}</span><span class="bacc__all"><BentoIcon name="check" size={14} /></span></div>
      {accounts.list.map((account, index) => (
        <div class:list={['bacc__option', index === accounts.selectedAccount && 'bacc__option--selected']}>
          <span class:list={['bacc__dot', `bacc__dot--${account.status}`]} />
          <div class="bacc__identity"><strong>{account.name}</strong><small>{accounts.statusText[account.status]}</small></div>
          <span class="bacc__label">{account.label}</span>
        </div>
      ))}
    </div>
    <div class="bacc__views">
      {[false, true].map((single) => (
        <div class:list={['bacc__view', single ? 'bacc__single' : 'bacc__all']}>
          <div class="bacc__view-head"><div><span class="bacc__muted">{single ? accounts.selectedLabel : accounts.connectedLabel}</span><p class="bacc__value">{money(single ? selected.value : connectedTotal)}</p></div><span class="bacc__filter">{single ? accounts.filterLabel(selected.label) : accounts.filterAll}<BentoIcon name="chevrons-up-down" size={12} /></span></div>
          <div class="bento__panel bacc__table">
            <div class="bacc__table-head"><span>{accounts.itemColumn}</span><span>{accounts.column}</span><span>{accounts.priceColumn}</span></div>
            {rows.filter((row) => !single || row.account === selected).map((row) => (
              <div class="bacc__row">
                <div class="bacc__item"><BentoThumb item={row} size={accounts.thumbSize} /><div><p class="bacc__muted">{row.weapon}</p><p>{row.skin}</p></div></div>
                <span class="bacc__owner">{row.account.name}</span>
                <span class="bacc__price">{money(row.price)}</span>
              </div>
            ))}
          </div>
          <p class="bacc__caption">{accounts.previewLabel}</p>
          {!single && <div class="bacc__notice"><p>{accounts.partialNotice(waiting.map((account) => account.name))}</p><span>{accounts.reconnect}<span aria-hidden="true"> ↗</span></span></div>}
        </div>
      ))}
    </div>
  </div>
</div>
