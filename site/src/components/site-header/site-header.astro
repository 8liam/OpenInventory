---
import { site } from '../../data/site.config';
import GithubLink from '../github-link/github-link.astro';
import { fetchStars } from '../../lib/github-stars/github-stars';
import { headerBrand, headerConfig as copy, headerHooks as hook } from './site-header.config';
const stars = await fetchStars();
const rootAttr = { [hook.root]: '' };
const sentinelAttr = { [hook.sentinel]: '' };
const menuAttr = { [hook.menu]: '' };
const panelAttr = { [hook.panel]: '' };
---
<div class="site-header__sentinel" {...sentinelAttr} aria-hidden="true"></div>
<header class="site-header" {...rootAttr}>
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label={headerBrand.homeLabel}>
      <svg class="site-header__mark" viewBox={headerBrand.markViewBox} width={headerBrand.markWidth} height={headerBrand.markHeight} aria-hidden="true" focusable="false">
        <path d={headerBrand.markPath} fill="var(--c-accent)" />
      </svg>
      <span class="site-header__wordmark">{headerBrand.name}</span>
    </a>
    <div class="site-header__panel" id="site-header-panel" {...panelAttr}>
      <nav class="site-header__nav" aria-label={copy.navigation}>
        {copy.links.map((link) => <a class="site-header__link" href={link.href}>{link.label}</a>)}
      </nav>
      <div class="site-header__actions">
        <GithubLink href={site.repo} label={copy.github} stars={stars} variant="chip" />
        <a class="site-header__pill site-header__pill--ghost" href={copy.selfHost.href}>{copy.selfHost.label}</a>
      </div>
    </div>
    <a class="site-header__pill site-header__pill--solid site-header__download" href={copy.download.href} rel="noopener">{copy.download.label}</a>
    <button class="site-header__menu" type="button" aria-label={copy.menu.open} aria-expanded="false" aria-controls="site-header-panel" {...menuAttr}>
      <svg class="site-header__menu-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path class="site-header__menu-bar site-header__menu-bar--top" d="M5 8.5h14" />
        <path class="site-header__menu-bar site-header__menu-bar--bottom" d="M5 15.5h14" />
      </svg>
    </button>
  </div>
</header>
<script>
  import { headerConfig, headerHooks, headerStates } from './site-header.config';

  const attr = (name: string) => `[${name}]`;
  const header = document.querySelector<HTMLElement>(attr(headerHooks.root));
  const panel = header?.querySelector<HTMLElement>(attr(headerHooks.panel));
  const button = header?.querySelector<HTMLButtonElement>(attr(headerHooks.menu));
  const sentinel = document.querySelector<HTMLElement>(attr(headerHooks.sentinel));

  if (header && panel && button) {
    const mobile = matchMedia(headerConfig.mobileQuery);
    const links = Array.from(panel.querySelectorAll<HTMLAnchorElement>('a'));
    let open = false;

    const setOpen = (next: boolean, restoreFocus = false) => {
      open = next && mobile.matches;
      header.classList.toggle(headerStates.open, open);
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? headerConfig.menu.close : headerConfig.menu.open);
      if (open) links[0]?.focus();
      else if (restoreFocus) button.focus();
    };

    header.classList.add(headerStates.enhanced);
    button.addEventListener('click', () => setOpen(!open, true));
    links.forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('pointerdown', (event) => {
      if (open && event.target instanceof Node && !header.contains(event.target)) setOpen(false);
    });
    header.addEventListener('keydown', (event) => {
      if (open && event.key === 'Escape') {
        event.preventDefault();
        setOpen(false, true);
      }
    });
    // Tabbing out of the open menu closes it instead of leaving it hanging over the page.
    header.addEventListener('focusout', (event) => {
      if (open && event.relatedTarget instanceof Node && !header.contains(event.relatedTarget)) setOpen(false);
    });
    mobile.addEventListener('change', () => setOpen(false));

    if (sentinel) {
      new IntersectionObserver(([entry]) => {
        header.classList.toggle(headerStates.scrolled, !entry.isIntersecting);
      }).observe(sentinel);
    }
  }
</script>
