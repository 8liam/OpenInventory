---
import { hero, lenses } from '../../data/site.config';
import CloudField from '../cloud-field/cloud-field.astro';
import { heroConfig } from './hero.config';
import LensGallery from '../lens/lens-gallery';
import DashboardDemo from '@demo/demo/dashboard-demo';
import ItemsDemo from '@demo/demo/items-demo';
import StorageDemo from '@demo/demo/storage-demo';
import CasesDemo from '@demo/demo/cases-demo';
import TradeUpDemo from '@demo/demo/tradeup-demo';
import GithubLink from '../github-link/github-link.astro';
import { fetchStars } from '../../lib/github-stars/github-stars';
import { ICON_PATHS } from '../../lib/download/download.icons';
import { COPY, RELEASES_PAGE, PLATFORMS } from '../../lib/download/download.config';
import { fetchRelease } from '../../lib/download/download.releases';
const [stars, release] = await Promise.all([fetchStars(), fetchRelease()]);
const iconNames = Object.keys(ICON_PATHS) as (keyof typeof ICON_PATHS)[];
const words = hero.headline.split(' ');
// Defaults can move into hero copy without changing this component.
const copy = { ...heroConfig.copy, ...hero };
const platforms = iconNames.map((icon) => ({
  icon,
  label: PLATFORMS.find((platform) => platform.icon === icon)?.label,
}));
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__sky">
    <CloudField variant="hero" />
    <div class="hero__head">
      <a class="hero__announcement" href={RELEASES_PAGE} rel="noopener" data-reveal>
        <span class="hero__new">{copy.announcementBadge}</span>
        <span>{copy.announcement}</span>
        <span class="hero__announcement-arrow" aria-hidden="true">→</span>
      </a>
      <h1 id="hero-title" class="hero__title" data-reveal style="--d:0.08s">
        <span>{words.slice(0, -1).join(' ')}</span>{' '}
        <span class="hero__accent">{words.at(-1)}</span>
      </h1>
      <p class="hero__lede" data-reveal style="--d:0.16s">{hero.lede}</p>

      <div class="hero__cta" data-reveal style="--d:0.24s">
        <a class="btn btn--solid btn--dl" data-dl data-dl-links={JSON.stringify(release.links)} href={RELEASES_PAGE} rel="noopener">
          <span class="btn__icon" aria-hidden="true">
            {iconNames.map((n) => (
              <svg data-dl-icon={n} hidden viewBox="0 0 24 24" width="18" height="18" fill="currentColor" focusable="false"><path d={ICON_PATHS[n]} /></svg>
            ))}
          </span>
          <span class="btn__label"><span data-dl-label data-text={COPY.fallbackLabel}>{COPY.fallbackLabel}</span></span>
          <span class="btn__arrow" aria-hidden="true">↓</span>
        </a>
        <GithubLink href={hero.secondary.href} label={hero.secondary.label} stars={stars} />
      </div>
      <div class="hero__platforms" data-reveal style="--d:0.32s">
        <span>{copy.platformsLabel}</span>
        <ul class="hero__platform-list" role="list">
          {platforms.map(({ icon, label }) => (
            <li title={label}>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false"><path d={ICON_PATHS[icon]} /></svg>
              <span class="sr-only">{label}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="hero__stage" id={lenses.id} data-reveal style="--d:0.44s">
    <LensGallery lenses={lenses.items} client:visible>
      <DashboardDemo slot="dashboard" client:visible />
      <ItemsDemo slot="items" client:visible />
      <StorageDemo slot="storage" client:visible />
      <CasesDemo slot="cases" client:visible />
      <TradeUpDemo slot="tradeup" client:visible />
    </LensGallery>
  </div>
</section>
